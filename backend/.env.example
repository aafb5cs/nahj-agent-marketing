# Copy to .env (never commit .env) and fill in. All settings are environment variables.

# Database: the nahj_market schema, with the marketplace's own user.
MK_DB_DSN=nahj_market_app:CHANGE_ME@tcp(127.0.0.1:3306)/nahj_market

# HTTP
MK_HTTP_ADDR=:8090
MK_PUBLIC_BASE_URL=http://localhost:8090
MK_COOKIE_SECURE=false          # true in staging and production (HTTPS)
MK_SESSION_TTL=12h
# 32 random bytes as hex, e.g.: openssl rand -hex 32
MK_SESSION_KEY=

# Keycloak (realm nahj). The web client is a confidential client with PKCE.
MK_OIDC_ISSUER=https://qa-sso.ryam.app/auth/realms/nahj
MK_OIDC_CLIENT_ID=marketplace-web
MK_OIDC_CLIENT_SECRET=
MK_OIDC_REDIRECT_URL=http://localhost:8090/api/v1/auth/callback
# Clients whose bearer tokens the API accepts (the Android app's client is "nahj").
MK_OIDC_ALLOWED_AZP=nahj

# Worker
MK_WORKER_BATCH=20
MK_WORKER_POLL=1s
MK_MAINTENANCE_EVERY=10m

MK_LOG_LEVEL=info

# Tests only: a server DSN without a database name.
# MK_TEST_MYSQL_DSN=root:root@tcp(127.0.0.1:3306)/
